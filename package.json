{
	"name": "svelte-adapter-ws",
	"version": "0.0.0",
	"private": true,
	"description": "SvelteKit adapter on node:http and ws - the svelte-adapter-uws realtime DX with no native addon",
	"author": "Kevin Radziszewski",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lanteanio/svelte-adapter-ws.git"
	},
	"homepage": "https://github.com/lanteanio/svelte-adapter-ws#readme",
	"bugs": {
		"url": "https://github.com/lanteanio/svelte-adapter-ws/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"default": "./src/index.js"
		},
		"./upgrade-response": {
			"types": "./src/upgrade-response.d.ts",
			"default": "./src/upgrade-response.js"
		},
		"./connection": {
			"types": "./src/connection.d.ts",
			"default": "./src/connection.js"
		}
	},
	"files": [
		"src",
		"protocol.schema.json",
		"test-vectors",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"probe": "node probe/ws-api-facts.mjs",
		"check:determinism": "node scripts/check-determinism.js",
		"check:publish": "publint && attw --pack . --profile esm-only",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench:slow-consumer": "node bench/slow-consumer.mjs",
		"bench:cluster-relay": "node bench/cluster-relay-fanout.mjs"
	},
	"dependencies": {
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-json": "^6.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"rollup": "^4.0.0",
		"ws": "^8.18.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"adapter",
		"ws",
		"websocket",
		"realtime",
		"node"
	],
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@sveltejs/kit": "^2.0.0",
		"acorn": "^8.18.0",
		"publint": "^0.3.22",
		"vitest": "^4.0.18"
	}
}
